# Nest API (airbnb-clone-api). The browser never calls it directly; only the BFF does.
API_BASE_URL=http://localhost:3000
# This app's own origin. CSRF checks compare the Origin header against it.
APP_ORIGIN=http://localhost:4100
# At least 32 random characters. Seals the session cookie. Never shared with apps/web.
SESSION_SECRET=
# Refresh this many seconds before the access token expires.
REFRESH_SKEW_SECONDS=30
BACKEND_TIMEOUT_MS=10000
