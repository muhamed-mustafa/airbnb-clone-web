{
  "name": "airbnb-clone-web",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev:admin": "pnpm --filter @stays/admin dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @stays/admin e2e",
    "api:sync": "pnpm --filter @stays/api-contract sync",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
